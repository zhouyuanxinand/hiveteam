{
  "name": "hiveteam",
  "version": "2.1.20",
  "description": "HiveTeam runs Claude Code, Codex, Gemini, OpenCode, Qwen, and other CLI agents as a visible local team in your browser.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "allowScripts": {
    "esbuild": true
  },
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "cli",
    "coding-agent",
    "collaboration",
    "local-first",
    "multi-agent",
    "pty",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouyuanxinand/hiveteam.git"
  },
  "bugs": {
    "url": "https://github.com/zhouyuanxinand/hiveteam/issues"
  },
  "homepage": "https://github.com/zhouyuanxinand/hiveteam#readme",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "files": [
    "assets/",
    "desktop/README.md",
    "desktop/acceptance.mjs",
    "desktop/app.mjs",
    "desktop/launch-mode.mjs",
    "desktop/main.mjs",
    "desktop/package.json",
    "desktop/pnpm-lock.yaml",
    "desktop/preload.cjs",
    "desktop/run-acceptance.mjs",
    "desktop/service-environment.mjs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "SECURITY.md",
    "dist/bin/",
    "dist/src/",
    "dist/vendor/",
    "scripts/dev-start.mjs",
    "scripts/ui-launcher.mjs",
    "web/dist/",
    "scripts/platform-console.mjs",
    "scripts/platform-environment.mjs",
    "scripts/platform-launch.mjs",
    "scripts/platform-owner.mjs",
    "scripts/platform-start.mjs",
    "scripts/platform-supervisor.mjs",
    "scripts/managed-node.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "hive": "dist/src/cli/hive.js"
  },
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "start": "node scripts/dev-start.mjs",
    "dev": "npm start",
    "dev:all": "npm start",
    "dev:runtime": "tsx src/cli/hive.ts --port 4010",
    "dev:web": "vite --config web/vite.config.ts",
    "desktop:install": "pnpm --dir desktop install --ignore-workspace",
    "desktop:dev": "pnpm --dir desktop start",
    "desktop:acceptance": "pnpm --dir desktop test:acceptance",
    "gateway:dev": "tsx gateway/src/main.ts",
    "gateway:build": "tsc -p gateway/tsconfig.json",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/prepare-build-artifacts.mjs && pnpm build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "pnpm exec biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p gateway/tsconfig.json",
    "format": "pnpm exec biome format --write .",
    "prepack": "pnpm build",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "pack:artifact": "node scripts/create-release-artifact.mjs",
    "publish:artifact": "node scripts/publish-release-artifact.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "release:compat": "node scripts/cli-compat-report.mjs",
    "release:dry": "pnpm check && pnpm typecheck && pnpm release:compat && pnpm build && pnpm test && pnpm pack:check && pnpm pack:smoke",
    "sync:marketplace": "node scripts/sync-marketplace.mjs",
    "test": "node scripts/run-tests.mjs run",
    "test:windows": "node scripts/run-tests.mjs run",
    "test:watch": "node scripts/run-tests.mjs watch"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.0",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.14.0",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.4",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "tar": "7.5.22",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
